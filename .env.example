# ==============================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# Copiar este archivo a ".env" y configurar los valores necesarios:
#   cp .env.example .env
# ==============================================================

# Configuración del Servidor Express
PORT=3000
NODE_ENV=development

# Configuración de Conexión a PostgreSQL
# NOTA: En entorno Docker Compose, DB_HOST debe coincidir con el nombre
# del servicio definido en docker-compose.yml ("db").
DB_HOST=db
DB_PORT=5432
DB_NAME=cloud_db
DB_USER=cloud_user
DB_PASSWORD=cloud_secure_password_example
